# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos (debe coincidir con docker-compose.yml si usas Docker) ---
POSTGRES_USER=parko
POSTGRES_PASSWORD=parko
POSTGRES_DB=parko
POSTGRES_PORT=5432
DATABASE_URL=postgresql://parko:parko@localhost:5432/parko?schema=public

# --- Stripe (modo test) ---
# Obtener en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_TEST_SECRET_KEY
# Obtener con `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET

# URLs a las que Stripe Checkout redirige tras el pago (paginas del frontend)
CHECKOUT_SUCCESS_URL=http://localhost:3000/success.html
CHECKOUT_CANCEL_URL=http://localhost:3000/cancel.html

# --- Autenticacion (multi-tenant: Admin General / Admin de Tenant / Usuario) ---
# Genera uno real con: openssl rand -base64 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h

# --- Bootstrap del primer Admin General (solo para `npm run create-super-admin`) ---
SUPER_ADMIN_EMAIL=admin@parko.dev
SUPER_ADMIN_PASSWORD=cambia-esta-contrasena

# --- Correo (Resend) ---
# Obtener en https://resend.com/api-keys
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY
# Sin dominio propio verificado en Resend, usa el remitente de pruebas
# (onboarding@resend.dev) — solo entrega a la cuenta dueña del API key.
EMAIL_FROM=Parko <onboarding@resend.dev>

# --- Chat (DeepSeek) ---
# Obtener en https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
# Tope de respaldo: mensajes de chat por tenant por dia (UTC). Protege el
# costo de DeepSeek pase lo que pase con la autenticacion del endpoint.
CHAT_DAILY_MESSAGE_LIMIT=200
